{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/vendor-oracle-client.js",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{config.xml,vendor/oracle/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
