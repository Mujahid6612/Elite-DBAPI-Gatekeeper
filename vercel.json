{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/vendor-oracle-client.js",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{config/tenants.jsonc,vendor/oracle/**,node_modules/oracledb/build/Release/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
