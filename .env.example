# HTTP server
PORT=5000

# Original Web.config value is used as a fallback when this is blank.
FLIGHTVIEW_URL=http://xml.flightview.com/fvEliteLimoPlus/fvxml.exe?

# "webapi" is the source-parity default: CLR string results are serialized by
# a Web API-style formatter. "raw" is available only for clients built against
# the migration markdown's raw-string assumption.
# Valid values: webapi | raw
STRING_RESPONSE_MODE=webapi

# Maximum accepted request body size, and therefore the primary DoS control.
# Accepts a byte count or a b/kb/mb/gb suffix. The original value was 2mb.
BODY_LIMIT=2mb

# Keep false/blank for source parity. The ASP.NET version did not trust XFF.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Oracle connection (REQUIRED — the pool cannot start without these three)
# ---------------------------------------------------------------------------
ORACLE_USER=
ORACLE_PASSWORD=
# TNS alias from tnsnames.ora, or an EZConnect string (host:port/service).
ORACLE_CONNECTION=

# The supplied config.xml uses a TNS alias in Data Source, so point these at a
# directory containing tnsnames.ora if the alias is not otherwise resolvable.
# ORACLE_CONFIG_DIR takes precedence; TNS_ADMIN is used as its fallback.
TNS_ADMIN=
ORACLE_CONFIG_DIR=

# Literal TEXT of a tnsnames.ora file (not a path), for deployments that cannot ship
# one on disk. .gitignore excludes *.ora and tns/, so a build made from the repository
# has no tnsnames.ora and a TNS ALIAS in ORACLE_CONNECTION fails with ORA-12154.
# When set, this is written to a file under the OS temp directory and used as configDir.
# Leave blank if you use a real ORACLE_CONFIG_DIR/TNS_ADMIN directory, or if you put the
# full connect descriptor directly into ORACLE_CONNECTION.
ORACLE_TNSNAMES=

# node-oracledb runs in Thin mode by default, which needs no Oracle Client
# libraries. Set ORACLE_THICK_MODE=true ONLY if your Oracle environment requires
# Thick mode, and then set ORACLE_CLIENT_LIB_DIR to the Instant Client directory.
#
# NOTE for the existing Windows deployment: the previous build called
# initOracleClient() unconditionally with a hardcoded path, i.e. it always ran in
# THICK mode regardless of this flag. To reproduce that exact behavior, set:
#   ORACLE_THICK_MODE=true
#   ORACLE_CLIENT_LIB_DIR=C:\app\azs\product\21c\dbhomeXE\bin
ORACLE_THICK_MODE=false
# Oracle Instant Client library directory. This is NOT the tnsnames.ora
# directory — do not point it at TNS_ADMIN.
ORACLE_CLIENT_LIB_DIR=

# Oracle connection pool tuning. LEAVE ALL BLANK to use node-oracledb's own defaults
# (poolMin=0, poolMax=4) - a blank value means "do not set this option at all", not
# "set it to zero". Note the default poolMax of 4 is the ceiling on how many database
# operations can run concurrently, regardless of host capacity.
#
# SERVERLESS DEPLOYMENTS: SET ORACLE_POOL_MAX EXPLICITLY.
# poolMax is per PROCESS, and every function instance is its own process with its own
# pool. Total sessions against Oracle are therefore (concurrent instances x poolMax),
# with nothing in this service capping the first factor - the platform decides how many
# instances to run. Left at the default of 4, twenty warm instances hold eighty sessions
# and can exhaust the database's session limit, which fails OTHER applications on the
# same database, not just this one. A low value (1-2) is usually right for serverless:
# an instance handles one request at a time, so a large per-instance pool buys nothing.
# On the long-running Windows host the opposite is true - one process serves all
# concurrency, so the default of 4 is the real concurrency ceiling and likely too low.
ORACLE_POOL_MIN=
ORACLE_POOL_MAX=
ORACLE_POOL_INCREMENT=
ORACLE_POOL_TIMEOUT=
ORACLE_QUEUE_TIMEOUT=
ORACLE_STMT_CACHE_SIZE=

# How long (ms) a graceful shutdown may take before the process is forced to exit.
SHUTDOWN_TIMEOUT_MS=15000

# Application log threshold for utils/appLogger.js (process lifecycle and unhandled
# request errors). This does NOT affect the per-tenant audit log under Log/, whose
# format and content are part of the .NET parity contract.
# Valid values: silent | error | warn | info | debug
LOG_LEVEL=info

# Base directory for RELATIVE tenant logPath values (config.xml ships `~/Log`).
# Blank means the project directory, which is the historical behavior. Set this when
# the deployment filesystem is read-only apart from a temp directory - on Vercel use
# LOG_ROOT=/tmp. The tenant audit log is not optional: the `1:`/`2:` markers are
# written on every POST regardless of enableLogging, and a write failure there fails
# a request whose database call already succeeded.
# NOTE: a temp directory is per-instance and ephemeral - not durable audit retention.
LOG_ROOT=

# Mirror every tenant audit entry to stdout in addition to its file. Default is
# true. On Vercel/Lambda the audit FILE lives under LOG_ROOT=/tmp, which is
# per-instance and wiped on recycle with no way to retrieve it - stdout is what
# reaches the platform log stream (and any log drain configured for retention).
# Set false to restore file-only behaviour on a conventional always-on server.
AUDIT_LOG_STDOUT=true

# Write one ACCESS entry per request capturing method, path, HTTP status code,
# duration in ms and client IP. Default true. This is the ONLY log record for
# routes other than POST /DBAPI/ProcessRequest (FlightView, the welcome and
# diagnostic GETs, and 404s). It records no request/response body, so it is
# independent of the per-tenant enableLogging flag in config.xml.
AUDIT_ACCESS_LOG=true

# Windows Event Log has no portable Node/Linux equivalent. Current tenants do
# not use logType=2. If one is introduced, this controls the fallback.
# Valid values: stderr | stdout
EVENT_LOG_FALLBACK=stderr

# Optional diagnostics. MUST stay false in production: when true, unhandled
# errors return the exception message AND full stack trace to the HTTP caller,
# disclosing filesystem paths and module layout to unauthenticated clients.
EXPOSE_ERRORS=false
